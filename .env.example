# ==========================================================
# VisualNotes AI - Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y coloca tus valores reales.
# NUNCA subas el archivo ".env" a GitHub.
# ==========================================================

# --- Inteligencia Artificial (obligatorio para usar funciones de IA) ---
# Consigue tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelos a usar (separados por coma, en orden de preferencia con fallback)
GEMINI_MODELS=gemini-flash-latest,gemini-2.0-flash,gemini-1.5-flash

# --- Seguridad / servidor ---
# Inicio de sesión deshabilitado por defecto (modo local).
# Pon "true" solo cuando quieras reactivar cuentas y sesiones.
ENABLE_AUTH=false

# Orígenes permitidos para CORS (lista separada por comas).
# Vacío = solo mismo origen (recomendado).
ALLOWED_ORIGINS=

# Límite de peticiones a la IA por IP y por minuto.
RATE_LIMIT_PER_MINUTE=20

# Tamaño máximo de archivo subido (audio/imagen), en MB.
MAX_UPLOAD_MB=25

# Ruta de la base de datos SQLite (opcional).
# En Docker se recomienda usar un volumen: /app/data/visualnotes.db
VISUALNOTES_DB=
